{
  "manifest_version": 3,
  "name": "Ad Inspector",
  "version": "1.0",
  "description": "Run ad quality tests on the current page",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Inspector"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
