{
  "manifest_version": 3,
  "name": "Ad Inspector",
  "version": "2.0",
  "description": "Auto-runs ad quality tests on every page load",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Inspector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
